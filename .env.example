# Port configuration (changeable to any free port, e.g. 8000 or 8080)
PORT=8080

# Host directory on your local machine where transcripts will be stored
# Can be a relative path (e.g. ./transcripts) or an absolute path (e.g. /home/user/youtube_transcripts)
HOST_TRANSCRIPTS_DIR=./transcripts

# Destination folder inside the container where transcripts are saved
OUTPUT_DIR=/data/transcripts

# Default subtitle language (manual first, automatic fallback)
DEFAULT_LANGUAGE=en

# Default delay in seconds between downloads to avoid YouTube 429 rate limiting
DEFAULT_DELAY=1.5
